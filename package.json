{
  "name": "dsh-taskboard",
  "version": "0.5.0",
  "description": "Local-first issue board for DSH — standalone plugin version, forked from reasonix-taskboard (dashi-taskboard).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttmouse/dsh-taskboard.git"
  },
  "homepage": "https://github.com/ttmouse/dsh-taskboard",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "taskboard",
    "kanban",
    "issue-tracker",
    "project-management",
    "cordis",
    "sqlite",
    "ai-agent"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "main": "plugin/lib/index.mjs",
  "exports": {
    ".": "./plugin/lib/index.mjs",
    "./client": "./plugin/lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "dev:server": "node --watch server/index.mjs --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "start": "node server/index.mjs",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.94.0",
    "@xyflow/react": "^12.11.2",
    "dhtmlx-gantt": "^10.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "license": "MIT"
}
